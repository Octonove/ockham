{
  "description": "Ockham: loads its rules when a session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeout": 10,
            "statusMessage": "Loading Ockham"
          }
        ]
      }
    ]
  }
}
