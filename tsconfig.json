{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["bin/**/*.mjs", "src/**/*.mjs", "hooks/**/*.mjs", "test/**/*.mjs", "bench/*.mjs", "bench/lib/**/*.mjs"],
  "exclude": ["node_modules", "bench/tasks", "bench/runs"]
}
